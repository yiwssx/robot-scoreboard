{
  "name": "robot-scoreboard",
  "version": "1.0.0",
  "description": "Offline trusted-LAN realtime competition scoreboard with local OBS broadcast integration",
  "main": "server/main.js",
  "scripts": {
    "start": "node server/main.js",
    "dev:client": "vite --config client/vite.config.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "typecheck:client": "tsc -p client/tsconfig.json --noEmit",
    "check": "node tools/dev/check-js.js && npm run typecheck:client",
    "test": "node --test tests/*.test.js",
    "stress:obs": "node tests/stress/obs-stress.js",
    "build:offline:windows": "powershell -ExecutionPolicy Bypass -File tools/release/build-offline-windows.ps1"
  },
  "keywords": ["scoreboard", "robot", "socket.io", "obs", "offline", "preact", "typescript"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "preact": "10.29.8",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
